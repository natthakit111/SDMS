# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000/api

# ── MySQL ─────────────────────────────────────
# ใช้ได้สองแบบ: DATABASE_URL (เช่นตอน deploy บน Railway) จะ override
# ค่าด้านล่างทั้งหมดถ้ามีการตั้งไว้ ถ้าไม่ตั้งจะ fallback ไปใช้ DB_* แทน
# DATABASE_URL=mysql://user:password@host:3306/dbname
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=sdms
# ขนาด connection pool สูงสุด — ไม่บังคับ ไม่ตั้งจะ default เป็น 10
# DB_POOL_SIZE=10

# ── Rate limiting ──────────────────────────────
# จำเป็นถ้า deploy backend มากกว่า 1 instance พร้อมกัน (เช่น Railway ที่
# scale เป็นหลาย replica) — ไม่ตั้งค่าไว้ rate limiter (auth.routes.js)
# จะ fallback ไปใช้ MemoryStore ซึ่งนับ counter แยกกันคนละ instance ทำให้
# บล็อก brute-force ไม่ทำงานจริง (ยืนยันจากการทดสอบ production จริง)
# REDIS_URL=redis://default:password@host:6379

# ── JWT / Cookie ───────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
# ตั้งเป็น true เฉพาะตอน deploy จริงที่ frontend/backend อยู่คนละโดเมน
# (บังคับ SameSite=None + Secure ให้ cookie ใช้งานข้ามโดเมนได้)
COOKIE_CROSS_SITE=false
# ตั้ง true เมื่อรันผ่าน HTTPS จริงเท่านั้น (ไม่ผูกกับ NODE_ENV)
COOKIE_SECURE=false

# ── Google OAuth ───────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── Telegram Bot ──────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=YourBotUsername
# secret ที่ share กันระหว่าง backend กับ telegram bot process เท่านั้น
# (ใช้ยืนยันตัวตนของ request ภายในที่ยิงมาที่ POST /api/telegram/link)
BOT_INTERNAL_SECRET=change_this_to_a_random_string
# Telegram chat id ของแอดมิน สำหรับรับแจ้งเตือนระบบ (เช่น bill ค้างชำระ)
ADMIN_TELEGRAM_CHAT_ID=your_personal_telegram_chat_id
# ── PromptPay ───────────────────────────────
# หมายเหตุ: ตอนนี้ตั้งค่าจริงผ่านหน้า Settings ในแอป (บันทึกลง DB) แล้ว
# ตัวแปรนี้เป็นค่าเริ่มต้น/fallback เท่านั้น
# PROMPTPAY_ID=0812345678

# ── Cloudinary (เก็บไฟล์อัปโหลด: สลิป, รูปมิเตอร์, ไฟล์สัญญา) ─────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (แจ้งเตือน / ลืมรหัสผ่าน) ──────────────
GMAIL_USER=youremail@gmail.com
# ต้องเป็น App Password จาก Google Account (ไม่ใช่รหัสผ่าน Gmail จริง)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── PDF Generation (puppeteer) ─────────────────
# ตั้งเฉพาะถ้า deploy บน environment ที่ไม่มี Chromium ติดมาให้ (เช่น
# บาง container ต้องระบุ path เอง — ดู Dockerfile ถ้ามี)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── File Upload ───────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5